{
  "_read_me": [
    "This file decides what the 'WHAT TO WEAR' list says. Edit the words in quotes or the numbers, then save.",
    "All temperatures are 'feels like' degrees F, after the comfort setting in config.json is applied.",
    "warmth_bands: checked top to bottom. The first band whose 'below' number is higher than the temperature is used.",
    "Words in {curly braces} are filled in automatically - keep them as-is.",
    "Run preview.bat after editing to see the result before it goes to the Kindle."
  ],

  "warmth_bands": [
    {"below": 15,  "wear": "Heaviest coat, hat, gloves, scarf", "evening": "Heaviest coat tonight"},
    {"below": 32,  "wear": "Winter coat, hat, gloves",          "evening": "Winter coat tonight"},
    {"below": 45,  "wear": "Warm jacket",                       "evening": "Warm jacket after dark"},
    {"below": 55,  "wear": "Sweater or fleece",                 "evening": "Sweater after dark"},
    {"below": 65,  "wear": "Light layer, long sleeves",         "evening": "Light jacket after dark"},
    {"below": 80,  "wear": "T-shirt weather",                   "evening": "Light layer after dark"},
    {"below": 999, "wear": "Light, loose clothes",              "evening": null}
  ],

